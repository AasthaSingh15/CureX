# From Supabase Dashboard > Connect. Prefer Session pooler for IPv4-only Windows networks.
# Keep sslmode=require. If using Transaction pooler (6543), append &prepareThreshold=0.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=replace-with-your-database-password
DB_POOL_SIZE=5
